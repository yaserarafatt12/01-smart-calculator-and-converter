# Pengaturan Aplikasi Kalkulator Pintar & Konverter
PORT=3000
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Opsional: API Key untuk Konversi Mata Uang Real-time (Nilai Placeholder Dummy)
NEXT_PUBLIC_CURRENCY_API_KEY=your_currency_api_key_here
